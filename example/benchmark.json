{
  "_note": "Labelled before any Jev call. must = files a scout has to surface; ok = related files that are not penalised. baseline_rg = the regex an informed agent might grep first.",
  "queries": [
    {"id": "cancel_kill", "question": "Where is a running shell command, and the processes it started, killed when the user stops a turn?",
     "must": ["internal/adapters/tools/shell.go", "internal/core/agent.go", "internal/adapters/tui/tui.go"],
     "ok": ["internal/adapters/skills/render.go", "internal/adapters/tools/shell_test.go", "internal/core/agent_test.go", "internal/adapters/tui/tui_test.go", "internal/adapters/tui/keys.go", "README.md", "docs/specs/subagents.md"],
     "baseline_rg": "Cancel|Kill|SIGKILL"},
    {"id": "api_key_command", "question": "Where is the provider's API key command run and its output used as the key?",
     "must": ["internal/config/config.go"],
     "ok": ["internal/config/config_test.go", "docs/specs/provider-config.md", "README.md", "main.go"],
     "baseline_rg": "apiKey|APIKey"},
    {"id": "result_truncation", "question": "Where is a tool result cut down when it is larger than the size limit?",
     "must": ["internal/core/tools.go"],
     "ok": ["internal/adapters/skills/render.go", "internal/core/agent_test.go", "CONTRIBUTING.md", "docs/specs/subagents.md", "docs/specs/skills.md"],
     "baseline_rg": "truncat|30_000|limit"},
    {"id": "markdown_render", "question": "Where are the assistant's replies rendered as markdown in the terminal?",
     "must": ["internal/adapters/tui/render.go"],
     "ok": ["internal/adapters/tui/transcript.go", "internal/adapters/tui/render_test.go", "README.md"],
     "baseline_rg": "markdown|Markdown"},
    {"id": "prompt_cache", "question": "Where is prompt caching configured on requests sent to the model API?",
     "must": ["internal/adapters/anthropic/provider.go"],
     "ok": ["internal/adapters/anthropic/provider_test.go"],
     "baseline_rg": "cache|Cache"},
    {"id": "skill_arguments", "question": "Where are skill arguments such as $ARGUMENTS substituted into a skill's content?",
     "must": ["internal/adapters/skills/render.go"],
     "ok": ["internal/adapters/skills/skills_test.go", "docs/specs/skills.md", "README.md", "internal/adapters/skills/skills.go"],
     "baseline_rg": "ARGUMENTS"},
    {"id": "clipboard_yank", "question": "Where is yanked transcript text copied to the system clipboard?",
     "must": ["internal/adapters/tui/tui.go", "internal/adapters/clipboard/clipboard.go"],
     "ok": ["internal/adapters/tui/view.go", "internal/adapters/tui/tui_test.go", "main.go", "README.md"],
     "baseline_rg": "clipboard|Clipboard"},
    {"id": "import_rules", "question": "What enforces that adapters do not import other adapters?",
     "must": ["scripts/check-imports.sh"],
     "ok": ["Makefile", "CONTRIBUTING.md"],
     "baseline_rg": "import"},
    {"id": "no_terminal_hang", "question": "What stops a command from hanging when it tries to prompt for a password on the terminal?",
     "must": ["internal/adapters/tools/shell.go", "internal/adapters/skills/render.go"],
     "ok": ["internal/adapters/tools/shell_test.go", "internal/adapters/skills/skills_test.go", "docs/specs/subagents.md", "internal/config/config.go", "README.md"],
     "baseline_rg": "tty|terminal|password"},
    {"id": "skill_dedup", "question": "Where is a skill that is already in the conversation prevented from being sent to the model again?",
     "must": ["internal/core/skills.go"],
     "ok": ["internal/core/skills_test.go", "internal/core/agent.go", "docs/specs/skills.md", "README.md", "CONTRIBUTING.md", "docs/specs/subagents.md"],
     "baseline_rg": "dedup|already"}
  ]
}
